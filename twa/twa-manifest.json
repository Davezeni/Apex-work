{
  "packageName": "com.apexwork.app",
  "name": "Apex-Work",
  "launcherName": "Apex-Work",
  "display": "standalone",
  "themeColor": "#7c3aed",
  "themeColorDark": "#0a0a0f",
  "navigationColor": "#0a0a0f",
  "navigationColorDark": "#0a0a0f",
  "navigationDividerColor": "#0a0a0f",
  "navigationDividerColorDark": "#0a0a0f",
  "backgroundColor": "#0a0a0f",
  "enableNotifications": true,
  "startUrl": "/",
  "iconUrl": "https://apex-work-gold.vercel.app/icon-512.png",
  "maskableIconUrl": "https://apex-work-gold.vercel.app/icon-512.png",
  "monochromeIconUrl": "https://apex-work-gold.vercel.app/icon.svg",
  "shortcuts": [
    { "name": "Messages", "url": "/messages" },
    { "name": "Post a job", "url": "/jobs/new" },
    { "name": "Wallet", "url": "/wallet" }
  ],
  "signingKey": { "path": "./apex-work-key.keystore", "alias": "apex-work" },
  "appVersionName": "1.0.0",
  "appVersionCode": 1,
  "shortcutsName": { "Messages": "Messages" },
  "fallbackType": "customtabs",
  "features": { "locationDelegation": { "enabled": true } },
  "alphaDependencies": { "enabled": false },
  "enableSiteSettingsShortcut": true,
  "isChromeOSOnly": false,
  "isMetaQuest": false,
  "includeSourceCode": false,
  "orientation": "portrait",
  "fingerprints": []
}
