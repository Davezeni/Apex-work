# ==========================================
# Apex-Work — Environment Variables Template
# Copy to .env and fill in values.
# This file mirrors apps/api/src/config/env.ts (the single source of truth).
# Secrets are NEVER committed; leave these blank and set them in the hosting
# dashboards (Render for the API, Vercel for the web).
# ==========================================

# ---------- Runtime ----------
NODE_ENV=development
# Render/PaaS set PORT automatically; local dev uses API_PORT.
PORT=
API_PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# ---------- Database (Neon / local Postgres) ----------
# Get from https://neon.tech (free tier)
DATABASE_URL=postgresql://user:password@localhost:5432/apexwork?schema=public
# Direct (unpooled) connection — used by Prisma migrations.
DATABASE_URL_UNPOOLED=postgresql://user:password@localhost:5432/apexwork?schema=public

# ---------- Redis (Upstash) ----------
# Get from https://upstash.com (free tier). Use the rediss:// TLS URL.
REDIS_URL=redis://localhost:6379

# ---------- Auth ----------
JWT_SECRET=change-me-to-random-32-char-string-min
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_ROUNDS=12

# ---------- SMS (AfroMessage — Ethiopian SMS provider) ----------
# Get from https://afromessage.com
AFROMESSAGE_API_KEY=
AFROMESSAGE_SENDER=ApexWork
AFROMESSAGE_IDENTIFIER_ID=

# ---------- Payments (Chapa) ----------
# Get from https://chapa.co (sandbox is free)
CHAPA_SECRET_KEY=CHASECK_TEST-xxx
CHAPA_PUBLIC_KEY=CHAPUBK_TEST-xxx
CHAPA_WEBHOOK_SECRET=
# Encryption key required by Chapa's newer API; optional in test mode.
CHAPA_ENCRYPTION_KEY=
# Keep OFF until Chapa Transfers bank-code mapping is verified in sandbox.
CHAPA_TRANSFERS_ENABLED=false

# ---------- OAuth (Google / GitHub sign-in) ----------
# Redirect URLs are derived from API_URL, so only these are needed.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---------- WebAuthn / passkeys ----------
# RP_ID = the domain WITHOUT scheme or port (e.g. "apex-work-gold.vercel.app").
# RP_ORIGIN = the full https origin the browser sees (e.g. "http://localhost:3000" in dev).
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Apex-Work
WEBAUTHN_RP_ORIGIN=http://localhost:3000

# ---------- Storage (Supabase Storage) ----------
# Get from https://supabase.com (free tier). Used for portfolio images,
# chat attachments and avatars.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# ---------- AI (Groq / Gemini, optional — app falls back to local generator) ----------
GROQ_API_KEY=
GEMINI_API_KEY=

# ---------- Web Push (VAPID) ----------
# Generate once with:  npx web-push generate-vapid-keys
VAPID_PUBLIC=
VAPID_PRIVATE=
VAPID_SUBJECT=mailto:support@apex-work.com

# ---------- Cron + WebRTC relay ----------
# Shared secret protecting /v1/cron/* (any 32+ char random string).
CRON_TOKEN=
# TURN relay for group calls (free tier: https://metered.ca). Optional.
METERED_API_KEY=
METERED_APP_NAME=apex_work

# ---------- Monitoring (optional) ----------
SENTRY_DSN=

# ---------- Web (Next.js PUBLIC vars — baked in at build time on Vercel) ----------
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Apex-Work
NEXT_PUBLIC_CHAPA_PUBLIC_KEY=CHAPUBK_TEST-xxx
