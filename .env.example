# ==========================================
# Apex-Work — Environment Variables Template
# Copy to .env and fill in values
# ==========================================

# ---------- API ----------
NODE_ENV=development
API_PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# ---------- Database (Neon / local Postgres) ----------
# Get from https://neon.tech (free tier)
DATABASE_URL=postgresql://user:password@localhost:5432/apexwork?schema=public
DATABASE_URL_UNPOOLED=postgresql://user:password@localhost:5432/apexwork?schema=public

# ---------- Redis (Upstash) ----------
# Get from https://upstash.com (free tier)
REDIS_URL=redis://localhost:6379

# ---------- Auth ----------
JWT_SECRET=change-me-to-random-32-char-string-min
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_ROUNDS=12

# ---------- SMS (AfroMessage — Ethiopian SMS provider) ----------
# Get from https://afromessage.com
AFROMESSAGE_API_KEY=
AFROMESSAGE_SENDER=ApexWork
AFROMESSAGE_IDENTIFIER_ID=

# ---------- Payments (Chapa) ----------
# Get from https://chapa.co (sandbox is free)
CHAPA_SECRET_KEY=CHASECK_TEST-xxx
CHAPA_PUBLIC_KEY=CHAPUBK_TEST-xxx
CHAPA_WEBHOOK_SECRET=

# ---------- Storage (Cloudflare R2 - S3 compatible) ----------
# Get from Cloudflare dashboard (free tier: 10GB)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=apex-work-uploads
R2_PUBLIC_URL=

# ---------- Email (Resend) ----------
# Get from https://resend.com (free tier: 3K emails/mo)
RESEND_API_KEY=
EMAIL_FROM=noreply@apex-work.et

# ---------- Optional: AI (Groq / Gemini) ----------
GROQ_API_KEY=
GEMINI_API_KEY=

# ---------- Optional: Monitoring ----------
SENTRY_DSN=
POSTHOG_KEY=

# ---------- Web (Next.js public vars) ----------
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Apex-Work
NEXT_PUBLIC_CHAPA_PUBLIC_KEY=CHAPUBK_TEST-xxx
