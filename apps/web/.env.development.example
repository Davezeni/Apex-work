# Copy to apps/web/.env.development for local dev overrides.
# Most values come from the root .env; put only web-specific overrides here.

NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Codespaces / reverse-proxy environments:
# Uncomment and set to your public preview host (no scheme, no port).
# NEXT_PUBLIC_APP_URL=https://humble-telegram-4prg79957p9hj99g-3000.app.github.dev

# Poll-based file watching (fixes HMR on Codespaces / Docker mounts / WSL)
WATCHPACK_POLLING=true
CHOKIDAR_USEPOLLING=true
