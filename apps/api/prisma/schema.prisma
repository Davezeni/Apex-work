// =============================================================
// Apex-Work — Prisma schema
// PostgreSQL. Prefer cuid() IDs, timestamped rows, soft-delete
// where user-facing, hard-delete for ephemeral tables.
// =============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ================= ENUMS =================

// RBAC: ADMIN is the legacy super-admin. MODERATOR/SUPPORT/FINANCE are
// scoped staff roles enforced by the admin capabilities map (see
// apps/api/src/lib/adminRbac.ts). Assignment happens only via the admin panel.
enum UserRole {
  CLIENT
  FREELANCER
  ADMIN
  MODERATOR
  SUPPORT
  FINANCE
}

enum OtpPurpose {
  SIGNUP
  LOGIN
  RESET
}

enum GigStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

/// Flag-queue workflow status for a flagged gig.
enum ModerationStatus {
  QUEUED    // flagged, awaiting a moderator
  IN_REVIEW // assigned / someone is working it
  RESOLVED  // action taken (e.g. removed/restored)
  DISMISSED // reviewed and cleared
}

enum PackageTier {
  BASIC
  STANDARD
  PREMIUM
}

enum OrderStatus {
  PENDING       // Awaiting payment
  ACTIVE        // Paid, freelancer working
  IN_REVIEW     // Delivered, awaiting client approval
  DELIVERED     // Approved
  COMPLETED     // Funds released
  CANCELLED
  DISPUTED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum TransactionType {
  ORDER_PAYMENT       // Client pays into escrow
  ORDER_PAYOUT        // Escrow -> freelancer
  ORDER_REFUND
  WITHDRAWAL
  PLATFORM_FEE
  REFERRAL_BONUS
  MANUAL_ADJUSTMENT   // Admin adjustment (audit-traced)
  ESCROW_REMINDER     // Non-financial marker (amount 0) so auto-release reminders don't collide with ledger idempotency
}

enum NotificationType {
  ORDER_UPDATE
  NEW_MESSAGE
  NEW_BID
  PAYMENT
  SYSTEM
  REVIEW
  REVIEW_REPLY
}

// ================= USERS =================

model User {
  id             String   @id @default(cuid())
  phone          String?  @unique
  email          String?  @unique
  passwordHash   String?  // null until user sets one (OTP-only accounts)
  pinHash        String?  // Argon2 hash of a 6-digit PIN, optional shortcut for repeat logins
  fullName       String
  username       String   @unique
  avatarUrl      String?
  role           UserRole @default(CLIENT)

  // Profile
  bio            String?
  title          String?  // e.g. "Senior UI Designer"
  city           String?
  country        String   @default("ET")
  hourlyRateEtb  Int?
  languages      String[] @default([])

  // Verification & status
  isPhoneVerified Boolean @default(false)
  isEmailVerified Boolean @default(false)
  isIdVerified   Boolean  @default(false)
  isOnboarded    Boolean  @default(false)
  isActive       Boolean  @default(true)
  suspendedAt    DateTime?

  // Denormalized stats (rebuilt via triggers/jobs)
  rating         Float    @default(0)
  ratingCount    Int      @default(0)
  completedOrders Int     @default(0)

  // Optional geo — freelancer opts in via /settings/profile to appear on
  // the map. Also enables 'Nearby' filter on browse. NULL = opted out.
  latitude       Float?
  longitude      Float?
  /// Human city string is kept for display; lat/lon powers the map.
  /// Availability is a compact JSON grid { day: [bool ×9 hour slots] } so
  /// we don't need a separate row-per-slot table for this feature.
  availabilityJson Json?
  /// Account-level notification category preferences. NULL uses safe defaults.
  notificationPrefsJson Json?

  // Referrals
  referralCode   String   @unique @default(cuid())
  referredById   String?
  referredBy     User?    @relation("Referrals", fields: [referredById], references: [id])
  referrals      User[]   @relation("Referrals")
  referralClicks ReferralClick[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  lastSeenAt     DateTime?

  // Relations
  skills         UserSkill[]
  skillsCreated  Skill[]              @relation("SkillCreator")
  portfolio      PortfolioItem[]
  gigs           Gig[]                @relation("GigOwner")
  savedGigs      SavedGig[]
  savedJobs      JobSave[]
  jobsPosted     Job[]                @relation("JobClient")
  bidsPlaced     Bid[]
  ordersAsClient Order[]              @relation("OrderClient")
  ordersAsSeller Order[]              @relation("OrderSeller")
  reviewsWritten Review[]             @relation("ReviewAuthor")
  reviewsAbout   Review[]             @relation("ReviewSubject")
  reviewsHidden  Review[]             @relation("ReviewHiddenBy")
  adminActions   AdminAuditLog[]      @relation("AdminActor")
  settingsUpdated AppSetting[]        @relation("SettingUpdatedBy")
  categoriesUpdated Category[]        @relation("CategoryUpdatedBy")
  kpiThresholdsUpdated KpiThreshold[] @relation("KpiThresholdUpdatedBy")
  kpiAlertsAcknowledged KpiAlert[]    @relation("KpiAlertAckBy")
  refreshTokens  RefreshToken[]
  sessions       Session[]
  trustedDevices TrustedDevice[]
  passkeys       Passkey[]
  oauthAccounts  OAuthAccount[]
  reports        Report[]             @relation("Reports")
  blocking       UserBlock[]          @relation("Blocker")
  blockedBy      UserBlock[]          @relation("Blocked")
  withdrawals    Withdrawal[]
  offersSent     CustomOffer[]        @relation("OffersSent")
  offersReceived CustomOffer[]        @relation("OffersReceived")
  conversations  ConversationMember[]
  messages       Message[]
  reactions      MessageReaction[]
  drafts         MessageDraft[]
  pushSubs       PushSubscription[]
  resume         Resume?
  resumeTemplatePurchases ResumeTemplatePurchase[]
  resumeVersions ResumeVersion[]
  profileEventsReceived ProfileEvent[] @relation("ProfileEventSubject")
  profileEventsCreated ProfileEvent[] @relation("ProfileEventViewer")
  subscriptions  Subscription[]
  agenciesOwned  Agency[]              @relation("AgencyOwner")
  agencyMemberships AgencyMember[]
  wallet         Wallet?
  transactions   Transaction[]
  notifications  Notification[]
  disputesOpened Dispute[]           @relation("DisputeOpener")
  savedSearches  SavedSearch[]
  supportTickets SupportTicket[]

  @@index([role, isActive])
  @@index([createdAt])
  @@index([city])
  ordersAssigned Order[]            @relation("OrderAssignee")
  bidCrew        Bid[]              @relation("BidCrew")
}

model RefreshToken {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique // hash, never store raw
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime @default(now())
  userAgent  String?
  ipAddress  String?

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  device    String?
  ipAddress String?
  lastUsed  DateTime @default(now())
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Otp {
  id         String     @id @default(cuid())
  phone      String
  codeHash   String     // never store raw
  purpose    OtpPurpose
  attempts   Int        @default(0)
  consumedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime   @default(now())

  @@index([phone, purpose])
  @@index([expiresAt])
}

// ================= PROFILE ANALYTICS =================
enum ProfileEventType {
  PROFILE_VIEW
  CV_VIEW
  CV_DOWNLOAD
  PORTFOLIO_VIEW
  PORTFOLIO_DOWNLOAD
}

/// Privacy-conscious profile analytics. viewerId is optional and is never
/// exposed publicly; only aggregate counts are returned to the profile owner.
model ProfileEvent {
  id             String           @id @default(cuid())
  subjectUserId  String
  viewerId       String?
  type           ProfileEventType
  targetId       String?
  createdAt      DateTime         @default(now())

  subject        User             @relation("ProfileEventSubject", fields: [subjectUserId], references: [id], onDelete: Cascade)
  viewer         User?            @relation("ProfileEventViewer", fields: [viewerId], references: [id], onDelete: SetNull)

  @@index([subjectUserId, type, createdAt(sort: Desc)])
  @@index([subjectUserId, createdAt(sort: Desc)])
}

// ================= SKILLS & PORTFOLIO =================

model Skill {
  id          String      @id @default(cuid())
  name        String      @unique
  slug        String      @unique
  category    String?
  isApproved  Boolean     @default(true)
  createdById String?

  users       UserSkill[]
  createdBy   User?       @relation("SkillCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([name])
  @@index([isApproved, name])
}

model UserSkill {
  userId  String
  skillId String
  level   Int    @default(1) // 1-5

  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([userId, skillId])
  @@index([skillId])
}

model PortfolioItem {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?  @db.Text
  imageUrl    String
  externalUrl String?
  role        String?
  tools       String[] @default([])
  outcome     String?  @db.Text
  tags        String[] @default([])
  featured    Boolean  @default(false)
  position    Int      @default(0)
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, position])
  @@index([userId, featured])
}

// ================= GIGS =================

model Gig {
  id             String       @id @default(cuid())
  ownerId        String
  title          String
  slug           String       @unique
  categoryId     String
  tags           String[]     @default([])
  description    String       @db.Text
  coverImageUrl  String?
  galleryUrls    String[]     @default([])
  status         GigStatus    @default(DRAFT)

  // Denormalized aggregates
  rating         Float        @default(0)
  ratingCount    Int          @default(0)
  ordersCount    Int          @default(0)
  viewsCount     Int          @default(0)
  startingPriceEtb Int        @default(0)

  /// Boosted placement — non-null featuredUntil pins the gig to the top of
  /// its category feed. Freelancer pays a small ETB fee to activate.
  isFeatured     Boolean      @default(false)
  featuredUntil  DateTime?

  /// Moderation / promotion. Admin can flag a gig for review, pin it to the
  /// top of a feed, or set it to be featured manually.
  isFlagged      Boolean      @default(false)
  flaggedReason  String?      @db.Text
  pinnedAt       DateTime?

  /// Moderation triage — assignee, workflow status and notes for the flag-queue.
  moderationStatus   ModerationStatus @default(QUEUED)
  moderationAssignee String?
  moderatorNotes     String?
  moderatedAt        DateTime?

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  owner          User         @relation("GigOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  savedBy        SavedGig[]
  packages       GigPackage[]
  orders         Order[]
  events         GigEvent[]

  @@index([ownerId])
  @@index([featuredUntil])
  @@index([categoryId, status])
  @@index([status, rating(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
}

model GigPackage {
  id            String      @id @default(cuid())
  gigId         String
  tier          PackageTier
  title         String
  description   String
  priceEtb      Int
  deliveryDays  Int
  revisions     Int         @default(0)

  gig           Gig         @relation(fields: [gigId], references: [id], onDelete: Cascade)

  @@unique([gigId, tier])
}

// ================= JOBS (client posts) =================

model Job {
  id            String    @id @default(cuid())
  clientId      String
  title         String
  categoryId    String
  description   String    @db.Text
  budgetMinEtb  Int?
  budgetMaxEtb  Int?
  requiredSkills String[] @default([])
  isRemote      Boolean   @default(true)
  isOpen        Boolean   @default(true)
  /// Admin can pin a job to the top of the jobs feed.
  pinnedAt      DateTime?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  closedAt      DateTime?

  client        User      @relation("JobClient", fields: [clientId], references: [id], onDelete: Cascade)
  bids          Bid[]
  attachments   JobAttachment[]
  savedBy       JobSave[]

  @@index([clientId])
  @@index([isOpen, createdAt(sort: Desc)])
  @@index([categoryId, isOpen])
}

/// Reference files uploaded when posting a job — briefs, mockups, spec PDFs.
/// Stored in Supabase and linked here so we can render them inline.
model JobAttachment {
  id          String   @id @default(cuid())
  jobId       String
  url         String
  name        String
  contentType String
  sizeBytes   Int
  createdAt   DateTime @default(now())

  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}

model Bid {
  id            String   @id @default(cuid())
  jobId         String
  freelancerId  String
  message       String   @db.Text
  priceEtb      Int
  deliveryDays  Int
  createdAt     DateTime @default(now())
  withdrawnAt   DateTime?

  job           Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  freelancer    User     @relation(fields: [freelancerId], references: [id], onDelete: Cascade)
  /// Set when a team manager/owner bids on behalf of their agency.
  agencyId String?
  agency   Agency?  @relation(fields: [agencyId], references: [id], onDelete: SetNull)
  /// Teammates pitching in on this joint bid (implicit m2m).
  crew     User[]   @relation("BidCrew")

  @@unique([jobId, freelancerId])
  @@index([freelancerId])
}

// ================= ORDERS & PAYMENTS =================

model Order {
  id              String        @id @default(cuid())
  orderNumber     String        @unique @default(cuid()) // for user-facing display
  clientId        String
  sellerId        String
  gigId           String?
  packageTier     PackageTier?
  title           String
  amountEtb       Int           // client-paid
  platformFeeEtb  Int           // deducted from seller
  sellerNetEtb    Int           // seller receives
  status          OrderStatus   @default(PENDING)
  deliveryDays    Int
  requirements    String?       @db.Text
  deliverables    Json?         // {files:[...], notes:''}
  deadline        DateTime?
  deliveredAt     DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  assignedToUserId String?
  assignedAt       DateTime?
  /// Snapshot (0-100) of the assignee's share of sellerNetEtb at assignment
  /// time. 0 = no assignment / legacy order → 100% to the seller as before.
  assigneeSharePct Int           @default(0)

  client          User          @relation("OrderClient", fields: [clientId], references: [id])
  seller          User          @relation("OrderSeller", fields: [sellerId], references: [id])
  assignedTo      User?         @relation("OrderAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  gig             Gig?          @relation(fields: [gigId], references: [id])
  payments        Payment[]
  reviews         Review[]
  conversation    Conversation?
  customOffer     CustomOffer?
  milestones      Milestone[]
  disputes        Dispute[]

  @@index([clientId, status])
  @@index([sellerId, status])
  @@index([status])
  @@index([assignedToUserId])
}

enum MilestoneStatus {
  PENDING       // Not yet delivered
  DELIVERED     // Freelancer marked done
  APPROVED      // Client approved → funds allocated
  DISPUTED
}

/// Optional milestones for an order — Upwork-style checkpoints.
/// Sum of milestone amounts must equal Order.amountEtb; the service layer
/// enforces that on create/update. Approving a milestone releases its
/// share of the escrow into the freelancer's wallet.
model Milestone {
  id          String          @id @default(cuid())
  orderId     String
  title       String
  description String?         @db.Text
  amountEtb   Int
  dueDate     DateTime?
  position    Int             @default(0)
  status      MilestoneStatus @default(PENDING)
  deliveredAt DateTime?
  approvedAt  DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, position])
  @@index([status])
}

model Payment {
  id              String        @id @default(cuid())
  orderId         String
  amountEtb       Int
  provider        String        // "chapa"
  providerRef     String?       @unique
  method          String?       // "telebirr", "cbebirr", "card"
  status          PaymentStatus @default(PENDING)
  rawPayload      Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
}

model Wallet {
  id               String        @id @default(cuid())
  userId           String        @unique
  balanceEtb       Int           @default(0)
  pendingEtb       Int           @default(0)  // held funds (in-review)
  lifetimeEarnedEtb Int          @default(0)
  updatedAt        DateTime      @updatedAt

  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Transaction {
  id           String          @id @default(cuid())
  userId       String
  type         TransactionType
  amountEtb    Int             // signed (+ credit, - debit)
  description  String
  relatedId    String?         // orderId / paymentId
  createdAt    DateTime        @default(now())

  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([type])
  // DB-level financial idempotency: a given financial event (user + type +
  // related record) may be recorded at most once. This makes a retried/duplicate
  // webhook, callback or cron run unable to double-credit or double-debit a
  // wallet — the ledgerOne() helper relies on it. NOTE: Postgres treats NULL
  // relatedId as distinct, so marker rows with no related record are unaffected.
  @@unique([userId, type, relatedId])
}

// ================= REVIEWS =================

model Review {
  id          String   @id @default(cuid())
  orderId     String
  authorId    String
  subjectId   String
  rating      Int      // 1-5
  comment     String?  @db.Text
  /// Optional photo URLs uploaded to Supabase (max 4, enforced in service).
  photoUrls   String[] @default([])
  createdAt   DateTime @default(now())

  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  author      User     @relation("ReviewAuthor", fields: [authorId], references: [id])
  subject     User     @relation("ReviewSubject", fields: [subjectId], references: [id])

  /// Moderation — hidden reviews are removed from the public list but kept
  /// for audit. `hiddenBy` is the staff member who hid it.
  hiddenAt    DateTime?
  hiddenById  String?
  hiddenReason String?  @db.Text
  hiddenBy    User?     @relation("ReviewHiddenBy", fields: [hiddenById], references: [id], onDelete: SetNull)

  /// Seller rebuttal — the subject of the review (the seller) may reply
  /// once, and edit/remove that reply, to give their side of the story.
  sellerReply       String?   @db.Text
  sellerRepliedAt   DateTime?
  sellerReplyEditedAt DateTime?

  @@unique([orderId, authorId])
  @@index([subjectId, createdAt(sort: Desc)])
  @@index([hiddenAt])
}

// ================= CHAT =================

model Conversation {
  id          String              @id @default(cuid())
  orderId     String?             @unique
  isGroup     Boolean             @default(false)
  title       String?             // groups
  avatarUrl   String?             // group avatar
  createdById String?             // set for groups; null for direct chats
  inviteToken String?             @unique // group join link token
  agencyId    String?             // set when this group is a team's shared chat
  agency      Agency?             @relation("AgencyConversation", fields: [agencyId], references: [id], onDelete: SetNull)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  lastMessageAt DateTime?

  order       Order?              @relation(fields: [orderId], references: [id])
  members     ConversationMember[]
  messages    Message[]
  customOffers CustomOffer[]
  drafts       MessageDraft[]

  @@index([lastMessageAt(sort: Desc)])
  @@index([createdById])
}

model ConversationMember {
  conversationId String
  userId         String
  joinedAt       DateTime @default(now())
  lastReadAt     DateTime?
  isMuted        Boolean  @default(false)
  /// Only meaningful for groups. Direct chats: both members are "member".
  isAdmin        Boolean  @default(false)

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
}

model Message {
  id              String       @id @default(cuid())
  conversationId  String
  senderId        String
  body            String?      @db.Text
  attachmentUrl   String?
  attachmentType  String?      // image, audio, video, file
  attachmentMeta  Json?        // {size, duration, name, transcript, waveform...}
  replyToId       String?
  editedAt        DateTime?
  deletedAt       DateTime?
  pinnedAt        DateTime?
  createdAt       DateTime     @default(now())

  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender          User         @relation(fields: [senderId], references: [id])
  replyTo         Message?     @relation("MessageReply", fields: [replyToId], references: [id])
  replies         Message[]    @relation("MessageReply")
  reactions       MessageReaction[]

  @@index([conversationId, createdAt(sort: Desc)])
  @@index([senderId])
}

/// One reaction per (message, user, emoji). Unique constraint enforces
/// that a user can hold each specific emoji on a message at most once, but
/// they can stack different emojis (❤️ + 👍) if they want.
model MessageReaction {
  id         String   @id @default(cuid())
  messageId  String
  userId     String
  emoji      String   // one grapheme cluster; validated in the service layer
  createdAt  DateTime @default(now())

  message    Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

// ================= NOTIFICATIONS =================

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String?
  payload   Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt(sort: Desc)])
}

// ================= FILE STORAGE (self-hosted fallback) =================
//
// A Postgres-backed object store used when the external storage provider
// (Supabase) is unavailable/not configured. Uploaded bytes live in `data`
// (bytea/TOAST) and are streamed out by GET /v1/files/:id. `path` is unique
// so the same logical key maps to one object.
model Upload {
  id          String   @id @default(cuid())
  ownerId     String
  bucket      String
  path        String   @unique
  filename    String
  contentType String
  sizeBytes   Int
  data        Bytes
  createdAt   DateTime @default(now())

  @@index([ownerId])
  @@index([bucket])
}


// ================= TRUSTED DEVICES =================

/// A device the user has verified once via OTP. Presenting a valid device
/// token lets them skip OTP on subsequent logins from the same phone.
/// We store only a HASH of the token — the raw value lives in the browser's
/// localStorage. Compromising the DB reveals nothing usable.
model TrustedDevice {
  id           String   @id @default(cuid())
  userId       String
  tokenHash    String   @unique  // sha256 of the device token
  label        String?          // "iPhone 14 · Chrome" (from UA parsing)
  userAgent    String?
  ipAddress    String?
  createdAt    DateTime @default(now())
  lastUsedAt   DateTime @default(now())
  expiresAt    DateTime         // rolling 30-day window
  revokedAt    DateTime?

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ================= PASSKEYS (WebAuthn) =================

/// FIDO2 / WebAuthn credentials for biometric login (Face ID, fingerprint,
/// Windows Hello, hardware keys). Stored per user; a user may register
/// multiple passkeys (one per device / browser).
model Passkey {
  id              String   @id @default(cuid())
  userId          String
  credentialId    String   @unique  // base64url-encoded credential id
  publicKey       String            // base64url-encoded COSE public key
  counter         BigInt   @default(0)
  transports      String[] @default([]) // 'internal', 'usb', 'nfc', 'ble'
  deviceType      String?           // 'singleDevice' | 'multiDevice'
  backedUp        Boolean  @default(false)
  label           String?           // "iPhone Face ID"
  createdAt       DateTime @default(now())
  lastUsedAt      DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ================= OAUTH ACCOUNTS =================
/// External identity linked to an Apex-Work account. We never store provider
/// access tokens; only the stable provider subject and verified profile data.
model OAuthAccount {
  id                String   @id @default(cuid())
  provider          String
  providerAccountId String
  userId            String
  email             String?
  profileName       String?
  avatarUrl         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
  @@index([userId])
}

// ================= MODERATION =================

enum ReportReason {
  SPAM
  HARASSMENT
  SCAM
  INAPPROPRIATE
  IMPERSONATION
  OTHER
}

enum ReportTargetType {
  USER
  GIG
  MESSAGE
  CONVERSATION
}

enum ReportStatus {
  OPEN
  REVIEWED
  DISMISSED
  ACTIONED
}

/// User-submitted reports. Reviewed manually until we build an admin dashboard.
model Report {
  id           String            @id @default(cuid())
  reporterId   String
  targetType   ReportTargetType
  targetId     String
  reason       ReportReason
  details      String?           @db.Text
  status       ReportStatus      @default(OPEN)
  createdAt    DateTime          @default(now())
  reviewedAt   DateTime?

  reporter     User              @relation("Reports", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@index([reporterId])
}

/// Blocks are one-way from blocker → blocked. Enforced at chat + reply time.
model UserBlock {
  blockerId  String
  blockedId  String
  createdAt  DateTime @default(now())
  reason     String?

  blocker    User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked    User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

// ================= WITHDRAWALS =================

enum WithdrawalStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  CANCELLED
}

enum WithdrawalDestination {
  TELEBIRR
  CBEBIRR
  CBE_BANK
  AWASH_BANK
  DASHEN_BANK
  BANK_OF_ABYSSINIA
}

/// Freelancer cashout requests. Fulfilled via Chapa B2C API or manually
/// when we haven't automated a given rail yet.
model Withdrawal {
  id             String                @id @default(cuid())
  userId         String
  amountEtb      Int
  feeEtb         Int                   @default(0)
  netEtb         Int                   // amount actually paid out (amount − fee)
  destination    WithdrawalDestination
  accountNumber  String
  accountName    String?
  status         WithdrawalStatus      @default(PENDING)
  providerRef    String?               // Chapa transfer id when we automate
  failureReason  String?
  createdAt      DateTime              @default(now())
  processedAt    DateTime?

  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([status])
}

// ================= CUSTOM OFFERS (in-chat) =================

enum CustomOfferStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
}

/// Freelancer sends a custom offer inside a conversation. Client can accept
/// → creates an Order and starts Chapa checkout, same flow as buying a gig.
model CustomOffer {
  id             String            @id @default(cuid())
  conversationId String
  senderId       String
  recipientId    String
  gigId          String?
  title          String
  description    String?           @db.Text
  priceEtb       Int
  deliveryDays   Int
  status         CustomOfferStatus @default(PENDING)
  orderId        String?           @unique  // set when accepted
  createdAt      DateTime          @default(now())
  respondedAt    DateTime?
  expiresAt      DateTime

  conversation   Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User              @relation("OffersSent", fields: [senderId], references: [id])
  recipient      User              @relation("OffersReceived", fields: [recipientId], references: [id])
  order          Order?            @relation(fields: [orderId], references: [id])

  @@index([conversationId, createdAt(sort: Desc)])
  @@index([recipientId, status])
}

// ================= RESUME / CV =================
// Structured resume/CV that freelancers build once and export as PDF.
// Kept separate from User to avoid bloating the row on every read.
model Resume {
  id            String            @id @default(cuid())
  userId        String            @unique
  headline      String?           // Big banner one-liner ("Senior React Developer · 5+ yrs")
  summary       String?           @db.Text
  phone         String?
  email         String?
  city          String?
  website       String?
  linkedin      String?
  github        String?
  targetRole    String?           // Role the AI coach and ATS review should optimize for.
  accentColor   String?           // User-selected six-digit hex accent.
  templateId    String            @default("classic")
  contentJson   Json?             // Skills, projects, achievements, volunteer, publications, references.
  isPublic      Boolean           @default(true)
  languages     String[]          @default([])   // ["English (Fluent)", "አማርኛ (Native)"]
  theme         String            @default("classic") // Legacy client field; templateId is canonical.
  updatedAt     DateTime          @updatedAt
  createdAt     DateTime          @default(now())

  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  experiences   WorkExperience[]
  education     Education[]
  certifications Certification[]
}

// A one-time Chapa purchase unlocks a premium Resume Studio template.
enum ResumeTemplatePurchaseStatus {
  PENDING
  PAID
  FAILED
}

model ResumeTemplateConfig {
  id          String   @id @default(cuid())
  templateId  String   @unique
  priceEtb    Int
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isAvailable])
}

model ResumeTemplatePurchase {
  id          String                       @id @default(cuid())
  userId      String
  templateId  String
  amountEtb   Int
  providerRef String                       @unique
  status      ResumeTemplatePurchaseStatus @default(PENDING)
  paidAt      DateTime?
  createdAt   DateTime                     @default(now())
  updatedAt   DateTime                     @updatedAt

  user        User                         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, templateId])
  @@index([userId, status])
  @@index([providerRef, status])
}

/// Named, user-owned resume snapshots for safe role tailoring and restore.
model ResumeVersion {
  id           String   @id @default(cuid())
  userId       String
  name         String
  targetRole   String?
  templateId   String?
  snapshotJson Json
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
}

// ================= SUBSCRIPTIONS =================
enum SubscriptionPlan {
  FREE
  FREELANCER_PRO
  CLIENT_PRO
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
}

/// One-time 30-day Pro passes backed by Chapa. Recurring billing is kept out
/// until a provider-approved recurring product is available.
model Subscription {
  id          String             @id @default(cuid())
  userId      String
  plan        SubscriptionPlan
  status      SubscriptionStatus @default(PENDING)
  amountEtb   Int
  providerRef String             @unique
  startedAt   DateTime?
  expiresAt   DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, expiresAt])
}

// ================= AGENCIES & TEAMS =================
model Agency {
  id        String         @id @default(cuid())
  ownerId   String
  name      String
  slug      String         @unique
  bio       String?        @db.Text
  logoUrl   String?
  website   String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  owner     User           @relation("AgencyOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members   AgencyMember[]
  conversations Conversation[] @relation("AgencyConversation")
  /// Default share (0-100) of an order payout offered to an assigned member
  /// when the owner assigns work. Snapshot onto the order at assignment time.
  defaultAssigneeSharePct Int @default(100)
  bids    Bid[]

  @@index([ownerId])
}

model AgencyMember {
  agencyId  String
  userId    String
  role      String   @default("MEMBER")
  createdAt DateTime @default(now())

  agency    Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([agencyId, userId])
  @@index([userId])
}

model WorkExperience {
  id          String   @id @default(cuid())
  resumeId    String
  company     String
  role        String
  location    String?
  startYear   Int
  startMonth  Int      // 1-12
  endYear     Int?     // null = current
  endMonth    Int?
  description String?  @db.Text
  position    Int      @default(0) // display order

  resume      Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId, position])
}

model Education {
  id          String   @id @default(cuid())
  resumeId    String
  school      String
  degree      String?
  fieldOfStudy String?
  startYear   Int
  endYear     Int?
  description String?  @db.Text
  position    Int      @default(0)

  resume      Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId, position])
}

model Certification {
  id          String   @id @default(cuid())
  resumeId    String
  name        String
  issuer      String
  issueYear   Int
  issueMonth  Int?
  credentialUrl String?
  position    Int      @default(0)

  // Verification — set by admin after checking the credentialUrl. The
  // freelancer's profile shows a ✓ badge when verifiedAt is not null.
  verifiedAt  DateTime?
  verifiedById String?

  resume      Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId, position])
  @@index([verifiedAt])
}

// ================= OFFLINE DRAFTS =================
// One draft per (user, conversation). Client persists a message locally while
// offline, then upserts the row when back online so the server has a durable
// backup. Also used to sync drafts across devices.
model MessageDraft {
  id             String       @id @default(cuid())
  userId         String
  conversationId String
  body           String       @db.Text
  attachmentUrl  String?
  attachmentType String?
  updatedAt      DateTime     @updatedAt
  createdAt      DateTime     @default(now())

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([userId, conversationId])
  @@index([userId, updatedAt(sort: Desc)])
}

// ================= WEB PUSH =================
// VAPID subscription rows — one per (user, endpoint). Endpoint is unique
// across the entire push service, so it's safe as the natural key.
model PushSubscription {
  id          String   @id @default(cuid())
  userId      String
  endpoint    String   @unique
  p256dh      String   // subscription.keys.p256dh
  authKey     String   // subscription.keys.auth
  userAgent   String?
  createdAt   DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ================= DISPUTES =================
enum DisputeStatus {
  OPEN
  REVIEWING
  RESOLVED_CLIENT   // Admin ruled in favour of client → refund
  RESOLVED_SELLER   // Admin ruled in favour of seller → release funds
  RESOLVED_SPLIT    // Custom split ruling
  WITHDRAWN         // Parties resolved it themselves
}

/// Formal escalation of a stuck order. Created by the client or freelancer
/// after a milestone dispute or a broken order flow. Admin resolves via
/// /v1/admin/disputes with a ruling and optional custom payout split.
model Dispute {
  id           String        @id @default(cuid())
  orderId      String
  openedById   String
  reason       String        @db.Text
  status       DisputeStatus @default(OPEN)
  /// When RESOLVED_SPLIT: how much (in ETB) goes to the client vs seller.
  clientPayoutEtb Int?
  sellerPayoutEtb Int?
  adminNotes   String?       @db.Text
  createdAt    DateTime      @default(now())
  resolvedAt   DateTime?

  order        Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  openedBy     User          @relation("DisputeOpener", fields: [openedById], references: [id])

  @@index([orderId])
  @@index([status, createdAt])
}

// ================= SAVED GIGS =================
/// A user's saved marketplace gigs. The compound unique key makes save/unsave
/// idempotent and keeps the list synchronized across browsers and devices.
model SavedGig {
  id        String   @id @default(cuid())
  userId    String
  gigId     String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gig       Gig      @relation(fields: [gigId], references: [id], onDelete: Cascade)

  @@unique([userId, gigId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([gigId])
}

model JobSave {
  id        String   @id @default(cuid())
  userId    String
  jobId     String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([jobId])
}

// ================= SAVED SEARCHES =================
enum SavedSearchType {
  GIGS
  JOBS
  USERS
}

/// User can save a search (query + optional category filter) and get
/// notified when new matches appear. Cron job scans hourly.
model SavedSearch {
  id           String          @id @default(cuid())
  userId       String
  name         String          // Friendly label, e.g. "React jobs in Addis"
  type         SavedSearchType
  query        String
  category     String?
  emailEnabled Boolean         @default(true)
  pushEnabled  Boolean         @default(true)
  /// Timestamp of the last run — only rows newer than this are counted as "new".
  lastCheckedAt DateTime       @default(now())
  createdAt    DateTime        @default(now())

  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([lastCheckedAt])
}

// ================= SUPPORT TICKETS =================
enum SupportTicketStatus {
  OPEN
  WAITING_USER
  WAITING_STAFF
  RESOLVED
  CLOSED
}

/// Full ticket system on top of the AI bot. User opens → staff replies via
/// SupportMessage → resolve/close.
model SupportTicket {
  id         String              @id @default(cuid())
  userId     String
  subject    String
  category   String              @default("general") // billing, dispute, tech, general
  status     SupportTicketStatus @default(OPEN)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  resolvedAt DateTime?

  /// CSAT — the user rates their support experience after resolution (1-5).
  csatRating   Int?
  csatComment  String?  @db.Text
  csatScoredAt DateTime?

  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages   SupportMessage[]

  @@index([status, updatedAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([csatScoredAt])
}

model SupportMessage {
  id         String        @id @default(cuid())
  ticketId   String
  senderId   String        // may be a user OR an admin
  body       String        @db.Text
  isStaff    Boolean       @default(false)
  createdAt  DateTime      @default(now())

  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

// ================= GIG ANALYTICS =================
enum GigEventType {
  VIEW
  IMPRESSION
  CONTACT     // opened messages from the gig
  ORDER_START // clicked continue → checkout
}

/// Fine-grained event log for the gig-owner analytics dashboard. Stored
/// as append-only rows; queries aggregate on the fly. Cheap to write, and
/// the (gigId, createdAt DESC) index makes range queries fast.
model GigEvent {
  id        String        @id @default(cuid())
  gigId     String
  type      GigEventType
  userId    String?
  createdAt DateTime      @default(now())

  gig       Gig           @relation(fields: [gigId], references: [id], onDelete: Cascade)

  @@index([gigId, createdAt(sort: Desc)])
  @@index([type, createdAt(sort: Desc)])
}

// ================= GIG TRANSLATIONS =================
/// Auto-translated version of a gig into another language. Generated on
/// demand via /v1/ai/translate. One row per (gigId, locale).
model GigTranslation {
  gigId     String
  locale    String   // 'am' or 'en' — extend as needed
  title     String
  description String @db.Text
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@id([gigId, locale])
  @@index([locale])
}

// ================= EMAIL QUEUE =================
enum EmailStatus {
  QUEUED
  SENT
  FAILED
}

/// Outbound email queue. A cron worker (/v1/cron/emails) flushes QUEUED
/// rows via Resend and marks them SENT/FAILED. Cheap durability so we
/// never lose a saved-search alert or dispute notification even if
/// Resend is temporarily down.
model EmailQueue {
  id         String      @id @default(cuid())
  to         String
  subject    String
  html       String      @db.Text
  status     EmailStatus @default(QUEUED)
  attempts   Int         @default(0)
  lastError  String?     @db.Text
  createdAt  DateTime    @default(now())
  sentAt     DateTime?

  @@index([status, createdAt])
}

// ================= ADMIN / OPS =================

/// Append-only log of every admin mutation. Every state-changing admin
/// endpoint must call `adminAudit()` (apps/api/src/lib/audit.ts) so the
/// platform can answer "who changed what and when".
model AdminAuditLog {
  id           String   @id @default(cuid())
  adminId      String
  adminName    String
  adminRole    String
  action       String   // e.g. "GIG.MODERATE", "USER.SUSPEND", "MONEY.CREDIT"
  resourceType String   // e.g. "GIG", "ORDER"
  resourceId   String?
  before       Json?
  after        Json?
  meta         Json?
  ip           String?
  createdAt    DateTime @default(now())

  admin        User     @relation("AdminActor", fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId, createdAt(sort: Desc)])
  @@index([resourceType, resourceId])
  @@index([action, createdAt(sort: Desc)])
}

/// Typed key/value store for runtime-tunable platform settings, feature flags
/// and per-category fees. Read once and cached by the app; edited only via
/// the admin panel. `value` is JSON so rows are typed per key.
model AppSetting {
  key         String   @id
  value       Json
  description String?
  updatedById String?
  updatedAt   DateTime @updatedAt

  updatedBy   User?    @relation("SettingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([updatedAt])
}

// ================= REFERRALS =================

/// Append-only log of referral-link clicks (used for tracked-link analytics
/// and to show "link clicks" on the referrals page). `refCode` is the
/// referrer's `referralCode`; `source` is the share surface the click came
/// from (link / whatsapp / telegram / etc).
model ReferralClick {
  id        String   @id @default(cuid())
  refCode   String
  source    String   @default("link")
  referrerId String?
  clickedAt DateTime @default(now())

  referrer  User?    @relation(fields: [referrerId], references: [id], onDelete: SetNull)

  @@index([refCode, clickedAt(sort: Desc)])
  @@index([referrerId, clickedAt(sort: Desc)])
}

// ================= CATEGORIES (per-category fees) =================

/// Marketplace category. `id` is the stable slug (e.g. 'development').
/// `feePercent` overrides the global `platform.feePercent` for orders in
/// this category; NULL inherits the global rate.
model Category {
  id         String   @id                 // slug
  label      String
  icon       String   @default("📦")
  feePercent Int?
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)
  updatedAt  DateTime @updatedAt
  updatedById String?

  updatedBy  User?    @relation("CategoryUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([isActive, sortOrder])
}

// ================= KPI WATCHER =================

/// A configurable threshold an admin wants to watch. The cron job computes
/// the current value and fires a KpiAlert when `operator` is breached.
model KpiThreshold {
  id        String   @id @default(cuid())
  key       String   @unique              // e.g. 'signups7d', 'gmv7d'
  label     String
  operator  String                        // 'lt' | 'gt'
  value     Float
  windowDays Int     @default(7)
  enabled   Boolean  @default(true)
  severity  String   @default("warn")     // 'info' | 'warn' | 'critical'
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  updatedById String?
  updatedBy User?    @relation("KpiThresholdUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  alerts    KpiAlert[]

  @@index([enabled, key])
}

/// A fired KPI alert. One open alert per key (deduped by the watcher).
model KpiAlert {
  id            String   @id @default(cuid())
  thresholdId   String
  key           String
  label         String
  operator      String
  metricValue   Float
  thresholdValue Float
  severity      String   @default("warn")
  status        String   @default("OPEN") // OPEN | ACKNOWLEDGED | RESOLVED
  message       String?
  firedAt       DateTime @default(now())
  acknowledgedAt DateTime?
  acknowledgedById String?
  resolvedAt    DateTime?

  threshold     KpiThreshold            @relation(fields: [thresholdId], references: [id], onDelete: Cascade)
  acknowledgedBy User?                  @relation("KpiAlertAckBy", fields: [acknowledgedById], references: [id], onDelete: SetNull)

  @@index([status, firedAt(sort: Desc)])
  @@index([thresholdId, firedAt(sort: Desc)])
}
