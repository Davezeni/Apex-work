// =============================================================
// Apex-Work — Prisma schema
// PostgreSQL. Prefer cuid() IDs, timestamped rows, soft-delete
// where user-facing, hard-delete for ephemeral tables.
// =============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ================= ENUMS =================

enum UserRole {
  CLIENT
  FREELANCER
  ADMIN
}

enum OtpPurpose {
  SIGNUP
  LOGIN
  RESET
}

enum GigStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum PackageTier {
  BASIC
  STANDARD
  PREMIUM
}

enum OrderStatus {
  PENDING       // Awaiting payment
  ACTIVE        // Paid, freelancer working
  IN_REVIEW     // Delivered, awaiting client approval
  DELIVERED     // Approved
  COMPLETED     // Funds released
  CANCELLED
  DISPUTED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum TransactionType {
  ORDER_PAYMENT       // Client pays into escrow
  ORDER_PAYOUT        // Escrow -> freelancer
  ORDER_REFUND
  WITHDRAWAL
  PLATFORM_FEE
  REFERRAL_BONUS
}

enum NotificationType {
  ORDER_UPDATE
  NEW_MESSAGE
  NEW_BID
  PAYMENT
  SYSTEM
  REVIEW
}

// ================= USERS =================

model User {
  id             String   @id @default(cuid())
  phone          String?  @unique
  email          String?  @unique
  passwordHash   String?  // null until user sets one (OTP-only accounts)
  pinHash        String?  // Argon2 hash of a 6-digit PIN, optional shortcut for repeat logins
  fullName       String
  username       String   @unique
  avatarUrl      String?
  role           UserRole @default(CLIENT)

  // Profile
  bio            String?
  title          String?  // e.g. "Senior UI Designer"
  city           String?
  country        String   @default("ET")
  hourlyRateEtb  Int?
  languages      String[] @default([])

  // Verification & status
  isPhoneVerified Boolean @default(false)
  isEmailVerified Boolean @default(false)
  isIdVerified   Boolean  @default(false)
  isOnboarded    Boolean  @default(false)
  isActive       Boolean  @default(true)
  suspendedAt    DateTime?

  // Denormalized stats (rebuilt via triggers/jobs)
  rating         Float    @default(0)
  ratingCount    Int      @default(0)
  completedOrders Int     @default(0)

  // Optional geo — freelancer opts in via /settings/profile to appear on
  // the map. Also enables 'Nearby' filter on browse. NULL = opted out.
  latitude       Float?
  longitude      Float?
  /// Human city string is kept for display; lat/lon powers the map.
  /// Availability is a compact JSON grid { day: [bool ×9 hour slots] } so
  /// we don't need a separate row-per-slot table for this feature.
  availabilityJson Json?
  /// Account-level notification category preferences. NULL uses safe defaults.
  notificationPrefsJson Json?

  // Referrals
  referralCode   String   @unique @default(cuid())
  referredById   String?
  referredBy     User?    @relation("Referrals", fields: [referredById], references: [id])
  referrals      User[]   @relation("Referrals")

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  lastSeenAt     DateTime?

  // Relations
  skills         UserSkill[]
  portfolio      PortfolioItem[]
  gigs           Gig[]                @relation("GigOwner")
  savedGigs      SavedGig[]
  jobsPosted     Job[]                @relation("JobClient")
  bidsPlaced     Bid[]
  ordersAsClient Order[]              @relation("OrderClient")
  ordersAsSeller Order[]              @relation("OrderSeller")
  reviewsWritten Review[]             @relation("ReviewAuthor")
  reviewsAbout   Review[]             @relation("ReviewSubject")
  refreshTokens  RefreshToken[]
  sessions       Session[]
  trustedDevices TrustedDevice[]
  passkeys       Passkey[]
  oauthAccounts  OAuthAccount[]
  reports        Report[]             @relation("Reports")
  blocking       UserBlock[]          @relation("Blocker")
  blockedBy      UserBlock[]          @relation("Blocked")
  withdrawals    Withdrawal[]
  offersSent     CustomOffer[]        @relation("OffersSent")
  offersReceived CustomOffer[]        @relation("OffersReceived")
  conversations  ConversationMember[]
  messages       Message[]
  reactions      MessageReaction[]
  drafts         MessageDraft[]
  pushSubs       PushSubscription[]
  resume         Resume?
  wallet         Wallet?
  transactions   Transaction[]
  notifications  Notification[]
  disputesOpened Dispute[]           @relation("DisputeOpener")
  savedSearches  SavedSearch[]
  supportTickets SupportTicket[]

  @@index([role, isActive])
  @@index([createdAt])
  @@index([city])
}

model RefreshToken {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique // hash, never store raw
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime @default(now())
  userAgent  String?
  ipAddress  String?

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  device    String?
  ipAddress String?
  lastUsed  DateTime @default(now())
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Otp {
  id         String     @id @default(cuid())
  phone      String
  codeHash   String     // never store raw
  purpose    OtpPurpose
  attempts   Int        @default(0)
  consumedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime   @default(now())

  @@index([phone, purpose])
  @@index([expiresAt])
}

// ================= SKILLS & PORTFOLIO =================

model Skill {
  id        String      @id @default(cuid())
  name      String      @unique
  slug      String      @unique
  category  String?

  users     UserSkill[]

  @@index([name])
}

model UserSkill {
  userId  String
  skillId String
  level   Int    @default(1) // 1-5

  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([userId, skillId])
  @@index([skillId])
}

model PortfolioItem {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  imageUrl    String
  externalUrl String?
  position    Int      @default(0)
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, position])
}

// ================= GIGS =================

model Gig {
  id             String       @id @default(cuid())
  ownerId        String
  title          String
  slug           String       @unique
  categoryId     String
  tags           String[]     @default([])
  description    String       @db.Text
  coverImageUrl  String?
  galleryUrls    String[]     @default([])
  status         GigStatus    @default(DRAFT)

  // Denormalized aggregates
  rating         Float        @default(0)
  ratingCount    Int          @default(0)
  ordersCount    Int          @default(0)
  viewsCount     Int          @default(0)
  startingPriceEtb Int        @default(0)

  /// Boosted placement — non-null featuredUntil pins the gig to the top of
  /// its category feed. Freelancer pays a small ETB fee to activate.
  isFeatured     Boolean      @default(false)
  featuredUntil  DateTime?

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  owner          User         @relation("GigOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  savedBy        SavedGig[]
  packages       GigPackage[]
  orders         Order[]
  events         GigEvent[]

  @@index([ownerId])
  @@index([featuredUntil])
  @@index([categoryId, status])
  @@index([status, rating(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
}

model GigPackage {
  id            String      @id @default(cuid())
  gigId         String
  tier          PackageTier
  title         String
  description   String
  priceEtb      Int
  deliveryDays  Int
  revisions     Int         @default(0)

  gig           Gig         @relation(fields: [gigId], references: [id], onDelete: Cascade)

  @@unique([gigId, tier])
}

// ================= JOBS (client posts) =================

model Job {
  id            String    @id @default(cuid())
  clientId      String
  title         String
  categoryId    String
  description   String    @db.Text
  budgetMinEtb  Int?
  budgetMaxEtb  Int?
  requiredSkills String[] @default([])
  isRemote      Boolean   @default(true)
  isOpen        Boolean   @default(true)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  closedAt      DateTime?

  client        User      @relation("JobClient", fields: [clientId], references: [id], onDelete: Cascade)
  bids          Bid[]
  attachments   JobAttachment[]

  @@index([clientId])
  @@index([isOpen, createdAt(sort: Desc)])
  @@index([categoryId, isOpen])
}

/// Reference files uploaded when posting a job — briefs, mockups, spec PDFs.
/// Stored in Supabase and linked here so we can render them inline.
model JobAttachment {
  id          String   @id @default(cuid())
  jobId       String
  url         String
  name        String
  contentType String
  sizeBytes   Int
  createdAt   DateTime @default(now())

  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}

model Bid {
  id            String   @id @default(cuid())
  jobId         String
  freelancerId  String
  message       String   @db.Text
  priceEtb      Int
  deliveryDays  Int
  createdAt     DateTime @default(now())
  withdrawnAt   DateTime?

  job           Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  freelancer    User     @relation(fields: [freelancerId], references: [id], onDelete: Cascade)

  @@unique([jobId, freelancerId])
  @@index([freelancerId])
}

// ================= ORDERS & PAYMENTS =================

model Order {
  id              String        @id @default(cuid())
  orderNumber     String        @unique @default(cuid()) // for user-facing display
  clientId        String
  sellerId        String
  gigId           String?
  packageTier     PackageTier?
  title           String
  amountEtb       Int           // client-paid
  platformFeeEtb  Int           // deducted from seller
  sellerNetEtb    Int           // seller receives
  status          OrderStatus   @default(PENDING)
  deliveryDays    Int
  requirements    String?       @db.Text
  deliverables    Json?         // {files:[...], notes:''}
  deadline        DateTime?
  deliveredAt     DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  client          User          @relation("OrderClient", fields: [clientId], references: [id])
  seller          User          @relation("OrderSeller", fields: [sellerId], references: [id])
  gig             Gig?          @relation(fields: [gigId], references: [id])
  payments        Payment[]
  reviews         Review[]
  conversation    Conversation?
  customOffer     CustomOffer?
  milestones      Milestone[]
  disputes        Dispute[]

  @@index([clientId, status])
  @@index([sellerId, status])
  @@index([status])
}

enum MilestoneStatus {
  PENDING       // Not yet delivered
  DELIVERED     // Freelancer marked done
  APPROVED      // Client approved → funds allocated
  DISPUTED
}

/// Optional milestones for an order — Upwork-style checkpoints.
/// Sum of milestone amounts must equal Order.amountEtb; the service layer
/// enforces that on create/update. Approving a milestone releases its
/// share of the escrow into the freelancer's wallet.
model Milestone {
  id          String          @id @default(cuid())
  orderId     String
  title       String
  description String?         @db.Text
  amountEtb   Int
  dueDate     DateTime?
  position    Int             @default(0)
  status      MilestoneStatus @default(PENDING)
  deliveredAt DateTime?
  approvedAt  DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, position])
  @@index([status])
}

model Payment {
  id              String        @id @default(cuid())
  orderId         String
  amountEtb       Int
  provider        String        // "chapa"
  providerRef     String?       @unique
  method          String?       // "telebirr", "cbebirr", "card"
  status          PaymentStatus @default(PENDING)
  rawPayload      Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
}

model Wallet {
  id               String        @id @default(cuid())
  userId           String        @unique
  balanceEtb       Int           @default(0)
  pendingEtb       Int           @default(0)  // held funds (in-review)
  lifetimeEarnedEtb Int          @default(0)
  updatedAt        DateTime      @updatedAt

  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Transaction {
  id           String          @id @default(cuid())
  userId       String
  type         TransactionType
  amountEtb    Int             // signed (+ credit, - debit)
  description  String
  relatedId    String?         // orderId / paymentId
  createdAt    DateTime        @default(now())

  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([type])
}

// ================= REVIEWS =================

model Review {
  id          String   @id @default(cuid())
  orderId     String
  authorId    String
  subjectId   String
  rating      Int      // 1-5
  comment     String?  @db.Text
  /// Optional photo URLs uploaded to Supabase (max 4, enforced in service).
  photoUrls   String[] @default([])
  createdAt   DateTime @default(now())

  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  author      User     @relation("ReviewAuthor", fields: [authorId], references: [id])
  subject     User     @relation("ReviewSubject", fields: [subjectId], references: [id])

  @@unique([orderId, authorId])
  @@index([subjectId, createdAt(sort: Desc)])
}

// ================= CHAT =================

model Conversation {
  id          String              @id @default(cuid())
  orderId     String?             @unique
  isGroup     Boolean             @default(false)
  title       String?             // groups
  avatarUrl   String?             // group avatar
  createdById String?             // set for groups; null for direct chats
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  lastMessageAt DateTime?

  order       Order?              @relation(fields: [orderId], references: [id])
  members     ConversationMember[]
  messages    Message[]
  customOffers CustomOffer[]
  drafts       MessageDraft[]

  @@index([lastMessageAt(sort: Desc)])
  @@index([createdById])
}

model ConversationMember {
  conversationId String
  userId         String
  joinedAt       DateTime @default(now())
  lastReadAt     DateTime?
  isMuted        Boolean  @default(false)
  /// Only meaningful for groups. Direct chats: both members are "member".
  isAdmin        Boolean  @default(false)

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
}

model Message {
  id              String       @id @default(cuid())
  conversationId  String
  senderId        String
  body            String?      @db.Text
  attachmentUrl   String?
  attachmentType  String?      // image, audio, video, file
  attachmentMeta  Json?        // {size, duration, name, transcript, waveform...}
  replyToId       String?
  editedAt        DateTime?
  deletedAt       DateTime?
  createdAt       DateTime     @default(now())

  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender          User         @relation(fields: [senderId], references: [id])
  replyTo         Message?     @relation("MessageReply", fields: [replyToId], references: [id])
  replies         Message[]    @relation("MessageReply")
  reactions       MessageReaction[]

  @@index([conversationId, createdAt(sort: Desc)])
  @@index([senderId])
}

/// One reaction per (message, user, emoji). Unique constraint enforces
/// that a user can hold each specific emoji on a message at most once, but
/// they can stack different emojis (❤️ + 👍) if they want.
model MessageReaction {
  id         String   @id @default(cuid())
  messageId  String
  userId     String
  emoji      String   // one grapheme cluster; validated in the service layer
  createdAt  DateTime @default(now())

  message    Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

// ================= NOTIFICATIONS =================

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String?
  payload   Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt(sort: Desc)])
}

// ================= TRUSTED DEVICES =================

/// A device the user has verified once via OTP. Presenting a valid device
/// token lets them skip OTP on subsequent logins from the same phone.
/// We store only a HASH of the token — the raw value lives in the browser's
/// localStorage. Compromising the DB reveals nothing usable.
model TrustedDevice {
  id           String   @id @default(cuid())
  userId       String
  tokenHash    String   @unique  // sha256 of the device token
  label        String?          // "iPhone 14 · Chrome" (from UA parsing)
  userAgent    String?
  ipAddress    String?
  createdAt    DateTime @default(now())
  lastUsedAt   DateTime @default(now())
  expiresAt    DateTime         // rolling 30-day window
  revokedAt    DateTime?

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ================= PASSKEYS (WebAuthn) =================

/// FIDO2 / WebAuthn credentials for biometric login (Face ID, fingerprint,
/// Windows Hello, hardware keys). Stored per user; a user may register
/// multiple passkeys (one per device / browser).
model Passkey {
  id              String   @id @default(cuid())
  userId          String
  credentialId    String   @unique  // base64url-encoded credential id
  publicKey       String            // base64url-encoded COSE public key
  counter         BigInt   @default(0)
  transports      String[] @default([]) // 'internal', 'usb', 'nfc', 'ble'
  deviceType      String?           // 'singleDevice' | 'multiDevice'
  backedUp        Boolean  @default(false)
  label           String?           // "iPhone Face ID"
  createdAt       DateTime @default(now())
  lastUsedAt      DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ================= OAUTH ACCOUNTS =================
/// External identity linked to an Apex-Work account. We never store provider
/// access tokens; only the stable provider subject and verified profile data.
model OAuthAccount {
  id                String   @id @default(cuid())
  provider          String
  providerAccountId String
  userId            String
  email             String?
  profileName       String?
  avatarUrl         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
  @@index([userId])
}

// ================= MODERATION =================

enum ReportReason {
  SPAM
  HARASSMENT
  SCAM
  INAPPROPRIATE
  IMPERSONATION
  OTHER
}

enum ReportTargetType {
  USER
  GIG
  MESSAGE
  CONVERSATION
}

enum ReportStatus {
  OPEN
  REVIEWED
  DISMISSED
  ACTIONED
}

/// User-submitted reports. Reviewed manually until we build an admin dashboard.
model Report {
  id           String            @id @default(cuid())
  reporterId   String
  targetType   ReportTargetType
  targetId     String
  reason       ReportReason
  details      String?           @db.Text
  status       ReportStatus      @default(OPEN)
  createdAt    DateTime          @default(now())
  reviewedAt   DateTime?

  reporter     User              @relation("Reports", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@index([reporterId])
}

/// Blocks are one-way from blocker → blocked. Enforced at chat + reply time.
model UserBlock {
  blockerId  String
  blockedId  String
  createdAt  DateTime @default(now())
  reason     String?

  blocker    User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked    User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

// ================= WITHDRAWALS =================

enum WithdrawalStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  CANCELLED
}

enum WithdrawalDestination {
  TELEBIRR
  CBEBIRR
  CBE_BANK
  AWASH_BANK
  DASHEN_BANK
  BANK_OF_ABYSSINIA
}

/// Freelancer cashout requests. Fulfilled via Chapa B2C API or manually
/// when we haven't automated a given rail yet.
model Withdrawal {
  id             String                @id @default(cuid())
  userId         String
  amountEtb      Int
  feeEtb         Int                   @default(0)
  netEtb         Int                   // amount actually paid out (amount − fee)
  destination    WithdrawalDestination
  accountNumber  String
  accountName    String?
  status         WithdrawalStatus      @default(PENDING)
  providerRef    String?               // Chapa transfer id when we automate
  failureReason  String?
  createdAt      DateTime              @default(now())
  processedAt    DateTime?

  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([status])
}

// ================= CUSTOM OFFERS (in-chat) =================

enum CustomOfferStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
}

/// Freelancer sends a custom offer inside a conversation. Client can accept
/// → creates an Order and starts Chapa checkout, same flow as buying a gig.
model CustomOffer {
  id             String            @id @default(cuid())
  conversationId String
  senderId       String
  recipientId    String
  gigId          String?
  title          String
  description    String?           @db.Text
  priceEtb       Int
  deliveryDays   Int
  status         CustomOfferStatus @default(PENDING)
  orderId        String?           @unique  // set when accepted
  createdAt      DateTime          @default(now())
  respondedAt    DateTime?
  expiresAt      DateTime

  conversation   Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User              @relation("OffersSent", fields: [senderId], references: [id])
  recipient      User              @relation("OffersReceived", fields: [recipientId], references: [id])
  order          Order?            @relation(fields: [orderId], references: [id])

  @@index([conversationId, createdAt(sort: Desc)])
  @@index([recipientId, status])
}

// ================= RESUME / CV =================
// Structured resume/CV that freelancers build once and export as PDF.
// Kept separate from User to avoid bloating the row on every read.
model Resume {
  id            String            @id @default(cuid())
  userId        String            @unique
  headline      String?           // Big banner one-liner ("Senior React Developer · 5+ yrs")
  summary       String?           @db.Text
  phone         String?
  email         String?
  city          String?
  website       String?
  linkedin      String?
  github        String?
  languages     String[]          @default([])   // ["English (Fluent)", "አማርኛ (Native)"]
  theme         String            @default("classic") // classic | modern | minimal
  updatedAt     DateTime          @updatedAt
  createdAt     DateTime          @default(now())

  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  experiences   WorkExperience[]
  education     Education[]
  certifications Certification[]
}

model WorkExperience {
  id          String   @id @default(cuid())
  resumeId    String
  company     String
  role        String
  location    String?
  startYear   Int
  startMonth  Int      // 1-12
  endYear     Int?     // null = current
  endMonth    Int?
  description String?  @db.Text
  position    Int      @default(0) // display order

  resume      Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId, position])
}

model Education {
  id          String   @id @default(cuid())
  resumeId    String
  school      String
  degree      String?
  fieldOfStudy String?
  startYear   Int
  endYear     Int?
  description String?  @db.Text
  position    Int      @default(0)

  resume      Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId, position])
}

model Certification {
  id          String   @id @default(cuid())
  resumeId    String
  name        String
  issuer      String
  issueYear   Int
  issueMonth  Int?
  credentialUrl String?
  position    Int      @default(0)

  // Verification — set by admin after checking the credentialUrl. The
  // freelancer's profile shows a ✓ badge when verifiedAt is not null.
  verifiedAt  DateTime?
  verifiedById String?

  resume      Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId, position])
  @@index([verifiedAt])
}

// ================= OFFLINE DRAFTS =================
// One draft per (user, conversation). Client persists a message locally while
// offline, then upserts the row when back online so the server has a durable
// backup. Also used to sync drafts across devices.
model MessageDraft {
  id             String       @id @default(cuid())
  userId         String
  conversationId String
  body           String       @db.Text
  attachmentUrl  String?
  attachmentType String?
  updatedAt      DateTime     @updatedAt
  createdAt      DateTime     @default(now())

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([userId, conversationId])
  @@index([userId, updatedAt(sort: Desc)])
}

// ================= WEB PUSH =================
// VAPID subscription rows — one per (user, endpoint). Endpoint is unique
// across the entire push service, so it's safe as the natural key.
model PushSubscription {
  id          String   @id @default(cuid())
  userId      String
  endpoint    String   @unique
  p256dh      String   // subscription.keys.p256dh
  authKey     String   // subscription.keys.auth
  userAgent   String?
  createdAt   DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ================= DISPUTES =================
enum DisputeStatus {
  OPEN
  REVIEWING
  RESOLVED_CLIENT   // Admin ruled in favour of client → refund
  RESOLVED_SELLER   // Admin ruled in favour of seller → release funds
  RESOLVED_SPLIT    // Custom split ruling
  WITHDRAWN         // Parties resolved it themselves
}

/// Formal escalation of a stuck order. Created by the client or freelancer
/// after a milestone dispute or a broken order flow. Admin resolves via
/// /v1/admin/disputes with a ruling and optional custom payout split.
model Dispute {
  id           String        @id @default(cuid())
  orderId      String
  openedById   String
  reason       String        @db.Text
  status       DisputeStatus @default(OPEN)
  /// When RESOLVED_SPLIT: how much (in ETB) goes to the client vs seller.
  clientPayoutEtb Int?
  sellerPayoutEtb Int?
  adminNotes   String?       @db.Text
  createdAt    DateTime      @default(now())
  resolvedAt   DateTime?

  order        Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  openedBy     User          @relation("DisputeOpener", fields: [openedById], references: [id])

  @@index([orderId])
  @@index([status, createdAt])
}

// ================= SAVED GIGS =================
/// A user's saved marketplace gigs. The compound unique key makes save/unsave
/// idempotent and keeps the list synchronized across browsers and devices.
model SavedGig {
  id        String   @id @default(cuid())
  userId    String
  gigId     String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gig       Gig      @relation(fields: [gigId], references: [id], onDelete: Cascade)

  @@unique([userId, gigId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([gigId])
}

// ================= SAVED SEARCHES =================
enum SavedSearchType {
  GIGS
  JOBS
  USERS
}

/// User can save a search (query + optional category filter) and get
/// notified when new matches appear. Cron job scans hourly.
model SavedSearch {
  id           String          @id @default(cuid())
  userId       String
  name         String          // Friendly label, e.g. "React jobs in Addis"
  type         SavedSearchType
  query        String
  category     String?
  emailEnabled Boolean         @default(true)
  pushEnabled  Boolean         @default(true)
  /// Timestamp of the last run — only rows newer than this are counted as "new".
  lastCheckedAt DateTime       @default(now())
  createdAt    DateTime        @default(now())

  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([lastCheckedAt])
}

// ================= SUPPORT TICKETS =================
enum SupportTicketStatus {
  OPEN
  WAITING_USER
  WAITING_STAFF
  RESOLVED
  CLOSED
}

/// Full ticket system on top of the AI bot. User opens → staff replies via
/// SupportMessage → resolve/close.
model SupportTicket {
  id         String              @id @default(cuid())
  userId     String
  subject    String
  category   String              @default("general") // billing, dispute, tech, general
  status     SupportTicketStatus @default(OPEN)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  resolvedAt DateTime?

  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages   SupportMessage[]

  @@index([status, updatedAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
}

model SupportMessage {
  id         String        @id @default(cuid())
  ticketId   String
  senderId   String        // may be a user OR an admin
  body       String        @db.Text
  isStaff    Boolean       @default(false)
  createdAt  DateTime      @default(now())

  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

// ================= GIG ANALYTICS =================
enum GigEventType {
  VIEW
  IMPRESSION
  CONTACT     // opened messages from the gig
  ORDER_START // clicked continue → checkout
}

/// Fine-grained event log for the gig-owner analytics dashboard. Stored
/// as append-only rows; queries aggregate on the fly. Cheap to write, and
/// the (gigId, createdAt DESC) index makes range queries fast.
model GigEvent {
  id        String        @id @default(cuid())
  gigId     String
  type      GigEventType
  userId    String?
  createdAt DateTime      @default(now())

  gig       Gig           @relation(fields: [gigId], references: [id], onDelete: Cascade)

  @@index([gigId, createdAt(sort: Desc)])
  @@index([type, createdAt(sort: Desc)])
}

// ================= GIG TRANSLATIONS =================
/// Auto-translated version of a gig into another language. Generated on
/// demand via /v1/ai/translate. One row per (gigId, locale).
model GigTranslation {
  gigId     String
  locale    String   // 'am' or 'en' — extend as needed
  title     String
  description String @db.Text
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@id([gigId, locale])
  @@index([locale])
}

// ================= EMAIL QUEUE =================
enum EmailStatus {
  QUEUED
  SENT
  FAILED
}

/// Outbound email queue. A cron worker (/v1/cron/emails) flushes QUEUED
/// rows via Resend and marks them SENT/FAILED. Cheap durability so we
/// never lose a saved-search alert or dispute notification even if
/// Resend is temporarily down.
model EmailQueue {
  id         String      @id @default(cuid())
  to         String
  subject    String
  html       String      @db.Text
  status     EmailStatus @default(QUEUED)
  attempts   Int         @default(0)
  lastError  String?     @db.Text
  createdAt  DateTime    @default(now())
  sentAt     DateTime?

  @@index([status, createdAt])
}
